<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.neherim</groupId>
        <artifactId>ruslo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ruslo-performance-test</artifactId>
    <description>Performance tests for ruslo library</description>

    <properties>
        <!-- Performance tests are not published -->
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>
        <perf.groups></perf.groups>
        <perf.excludedGroups>performance</perf.excludedGroups>
        <ruslo.perf.output-directory>${project.build.directory}/performance-results/${maven.build.timestamp}</ruslo.perf.output-directory>
    </properties>

    <dependencies>
        <!-- Ruslo Core -->
        <dependency>
            <groupId>io.github.neherim</groupId>
            <artifactId>ruslo-core</artifactId>
        </dependency>

        <!-- PostgreSQL Testcontainers -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- HikariCP Connection Pool -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Increase memory for large-scale tests -->
                    <argLine>-Xmx4g -XX:+UseG1GC</argLine>
                    <!-- Longer timeout for performance tests -->
                    <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
                    <!-- Fresh JVM per test class to avoid resource contention -->
                    <reuseForks>false</reuseForks>
                    <!-- Performance tests are excluded by default and selected by the perf-tests profile -->
                    <groups>${perf.groups}</groups>
                    <excludedGroups>${perf.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <ruslo.perf.output-directory>${ruslo.perf.output-directory}</ruslo.perf.output-directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>perf-tests</id>
            <properties>
                <!-- Re-enable tests in this module, overriding the root profile -->
                <skipTests>false</skipTests>
                <perf.groups>performance</perf.groups>
                <perf.excludedGroups></perf.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
